<h1>All Posts</h1>

<h2>Posts</h2>
<% if user_signed_in? %>
  <%= link_to "Create New Post", new_post_path %>
<% else %>
  <%= link_to "Sign in to create posts", new_user_session_path %>
<% end %>

<% @post.each do |post| %>
<div>
    <h3><%= post.title %></h3>
    <% if user_signed_in? %>
      <p>Posted by: <%= post.user.email %></p>
    <% end %>
</div>
<hr>
<% end %>